# Copy to .env and fill in. .env is gitignored.

ENVIRONMENT=development
DEBUG=true

# Local host runs: Postgres is mapped to host port 5433 by docker-compose.
# (The api container itself connects to db:5432 internally — see docker-compose.yml.)
DATABASE_URL=postgresql+asyncpg://gridclean:gridclean@localhost:5433/gridclean
REDIS_URL=redis://localhost:6379/0

# External APIs (needed from Phase 1 / Phase 4)
# Get a free EIA key at https://www.eia.gov/opendata/register.php
EIA_API_KEY=
# Anthropic key for the AI layer (Phase 4)
ANTHROPIC_API_KEY=
