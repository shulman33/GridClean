# Copy to .env and fill in. .env is gitignored.

ENVIRONMENT=development
DEBUG=true

# Local host runs: Postgres is mapped to host port 5433 by docker-compose.
# (The api container itself connects to db:5432 internally — see docker-compose.yml.)
DATABASE_URL=postgresql+asyncpg://gridclean:gridclean@localhost:5433/gridclean
REDIS_URL=redis://localhost:6379/0

# External APIs (needed from Phase 1 / Phase 4)
# Get a free EIA key at https://www.eia.gov/opendata/register.php
EIA_API_KEY=
# Anthropic key for the AI layer (Phase 4)
ANTHROPIC_API_KEY=

# AI layer
# Model for text-to-SQL + narration. Set to claude-sonnet-4-6 to cut cost.
AI_MODEL=claude-opus-4-8
# Login password for the read-only DB role the AI uses (created by migration).
# CHANGE THIS in production — it's how the read-only role authenticates.
AI_DB_PASSWORD=gridclean_ro_pw

# Anonymous (no API key) rate limit, requests/min/IP.
ANONYMOUS_RATE_LIMIT_PER_MIN=30

# --- Production notes ---
# On a managed host set ENVIRONMENT=production, DEBUG=false, and provide a
# DATABASE_URL like:
#   postgresql+asyncpg://USER:PW@HOST/DB?ssl=require
# (use ?ssl=require for asyncpg — NOT ?sslmode=require). See docs/DEPLOY.md.
